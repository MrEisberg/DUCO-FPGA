// Tang Nano 20K (GW2AR-LV18QN88C8/I7) Pin Constraints
// Reference: Sipeed Tang Nano 20K schematic

// 27 MHz onboard oscillator
IO_LOC "clk" 4;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// User button S1 (active-high on Tang Nano 20K, external pull-down)
IO_LOC "btn_rst" 88;
IO_PORT "btn_rst" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

// Onboard UART (connected to BL616 USB-UART bridge)
IO_LOC "uart_tx" 69;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "uart_rx" 70;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Onboard LED (active-low: pin 15, blinks on done job)
IO_LOC "led" 15;
IO_PORT "led" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "led[2]" 17;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "led[3]" 18;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "led[4]" 19;
IO_PORT "led[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "led[5]" 20;
IO_PORT "led[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// WS2812 RGB LED
IO_LOC "rgb_led" 79;
IO_PORT "rgb_led" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
