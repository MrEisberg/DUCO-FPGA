// Tang Nano 20K (GW2AR-LV18QN88C8/I7) Pin Constraints
// Reference: Sipeed Tang Nano 20K schematic

// 27 MHz onboard oscillator
IO_LOC "clk" 4;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// User button S1 (active-low on board, or S2 on pin 87)
IO_LOC "rst_n" 88;
IO_PORT "rst_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Onboard UART (connected to BL616 USB-UART bridge)
// IO_LOC "uart_tx" 69;
// IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
// IO_LOC "uart_rx" 70;
// IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Onboard LEDs (active-low: pins 15, 16, 17, 18, 19, 20)
// IO_LOC "led[0]" 15;
// IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
